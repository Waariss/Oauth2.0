{
  "name": "OAuth 2.0 Flow Inspector",
  "version": "2.0.0",
  "description": "Capture OAuth requests/callbacks and assess CSRF exposure from state/code validation.",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
